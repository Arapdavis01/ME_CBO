<!doctype html>
<html>
  <body style="margin:0;padding:0;background:#f8fafc;font-family:system-ui,-apple-system,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f8fafc;padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:16px;overflow:hidden;">
            <tr>
              <td style="background:#14532d;padding:24px 32px;color:#ffffff;">
                <h1 style="margin:0;font-size:20px;">Your ME_CBO impact certificate is ready</h1>
              </td>
            </tr>
            <tr>
              <td style="padding:32px;">
                <p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#475569;">
                  Congratulations {{memberName}}! Your certificate <strong>{{certificateTitle}}</strong> is attached to this email.
                </p>
                <p style="margin:0;font-size:13px;color:#64748b;">
                  Verification code: <code>{{verificationCode}}</code>
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
