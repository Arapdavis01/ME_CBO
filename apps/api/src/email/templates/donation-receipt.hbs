<!doctype html>
<html>
  <body style="margin:0;padding:0;background:#f8fafc;font-family:system-ui,-apple-system,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f8fafc;padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:16px;overflow:hidden;">
            <tr>
              <td style="background:#14532d;padding:24px 32px;color:#ffffff;">
                <h1 style="margin:0;font-size:20px;">Thank you, {{donorName}} 🌱</h1>
              </td>
            </tr>
            <tr>
              <td style="padding:32px;">
                <p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#475569;">
                  Your donation of <strong style="color:#14532d;">{{amountKes}}</strong> has been received.
                  Every shilling plants trees and empowers Mosoriot volunteers.
                </p>
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:16px 0;border:1px solid #e2e8f0;border-radius:8px;">
                  <tr><td style="padding:8px 12px;font-size:13px;color:#64748b;">Receipt #</td><td style="padding:8px 12px;font-size:13px;color:#0f172a;text-align:right;">{{receiptNumber}}</td></tr>
                  <tr><td style="padding:8px 12px;font-size:13px;color:#64748b;">Method</td><td style="padding:8px 12px;font-size:13px;color:#0f172a;text-align:right;">{{method}}</td></tr>
                  <tr><td style="padding:8px 12px;font-size:13px;color:#64748b;">Date</td><td style="padding:8px 12px;font-size:13px;color:#0f172a;text-align:right;">{{date}}</td></tr>
                </table>
                <p style="margin:0;font-size:13px;color:#64748b;">
                  Keep this email as your tax receipt. Thank you for caring for creation.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
